#!/bin/sh
MUR_REPO="https://raw.githubusercontent.com/MacroMag-os/MUR/main
"
MUR_DB="/var/lib/mur"
mkdir -p "$MUR_DB" /usr/bin

sync_mur() {
    echo "[MUR] Sprawdzanie aktualizacji w repozytorium GitHub..."
    curl -fsSL "$MUR_REPO/index.json" -o "$MUR_DB/index.new.json" || return 1

    if ! cmp -s "$MUR_DB/index.new.json" "$MUR_DB/index.json"; then
        mv "$MUR_DB/index.new.json" "$MUR_DB/index.json"
        echo "[MUR] Wykryto nowe pakiety! Pobieranie narzędzi..."
        
        grep -E '"name"|"url"' "$MUR_DB/index.json" | paste - - | while read -r line; do
            PKG_NAME=$(echo "$line" | sed -E 's/.*"name": *"([^"]+)".*/\1/')
            PKG_URL=$(echo "$line" | sed -E 's/.*"url": *"([^"]+)".*/\1/')
            
            if [ ! -f "/usr/bin/$PKG_NAME" ]; then
                echo "[MUR] Instalowanie: $PKG_NAME..."
                curl -fsSL "$PKG_URL" -o "/usr/bin/$PKG_NAME" && chmod +x "/usr/bin/$PKG_NAME"
            fi
        done
        echo "[MUR] System zaktualizowany!"
    else
        rm -f "$MUR_DB/index.new.json"
        echo "[MUR] Wszystko aktualne."
    fi
}

case "$1" in
    sync) sync_mur ;;
    *) sync_mur ;;
esac
